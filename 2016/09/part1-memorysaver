#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings

our ($input) = map { chomp; $_ } <>;

# This version saves memory by not generating the actual output
my $len = 0;
while ($input) {
    $len += length($1) if $input =~ s/^(.*?)(?=\(\d+x\d+\)|$)//;
    if ($input =~ s/^\((\d+)x(\d+)\)//) {
        $len += length(substr($input, 0, $1, '')) * $2;
    }
}

say $len;
