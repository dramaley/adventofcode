#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings
use Digest::MD5 qw/md5_hex/;

$| = 1;                         # Unbuffered output
our $fill = '_';                # Represents unfound password characters

our ($doorid) = map { chomp; $_ } <>;
my $password = $fill x 8;
for (my $i = 0; $password =~ /${fill}/; $i++) {
    my $hash = md5_hex("${doorid}${i}");
    next if $hash !~ /^00000([0-7])(\w)/;
    next if substr($password, $1, 1) ne $fill;
    substr($password, $1, 1, $2);
    print "${password}\r";      # \r is carriage return
}
print "\n";
