#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings

# What to add to ($row, $col) for each direction
our @movement = ([-1,  0],      # Up
                 [ 0,  1],      # Right
                 [ 1,  0],      # Down
                 [ 0, -1]);     # Left

# Starting position
our ($row, $col, $dir) = (0) x 3;

# Figure out the destination
foreach my $instruction (map { chomp; split /, /; } <>) {
    $instruction =~ m/^(?<dir>L|R)(?<dist>\d+)$/ or die;

    $dir += $+{'dir'} eq 'L' ? -1 : 1;
    $dir %= @movement;

    $row += $movement[$dir][0] * $+{'dist'};
    $col += $movement[$dir][1] * $+{'dist'};
}

say abs($row) + abs($col);
