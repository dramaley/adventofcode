#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings

# Read input
our @data = map { [ map { int } m/(\d+)/g ] } <>;

# Consider each set of 3 rows as a separate 3×3 matrix. Use swaps to transpose
# the matrices such that triangles are now by row rather than by column.
for (my $i = 0; $i < @data; $i += 3) {
    ($data[$i][1], $data[$i+1][0]) = ($data[$i+1][0], $data[$i][1]);
    ($data[$i][2], $data[$i+2][0]) = ($data[$i+2][0], $data[$i][2]);
    ($data[$i+1][2], $data[$i+2][1]) = ($data[$i+2][1], $data[$i+1][2]);
}

# Now identify possible triangles
my $possible = 0;
foreach (@data) {
    my ($a, $b, $c) = sort { $a <=> $b } @$_;
    $possible++ if $a + $b > $c;
}
say $possible;
