#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings

# Sample
#our @grid = ([ (0) x 7 ], [ (0) x 7 ], [ (0) x 7 ]);
# Real input
our @grid = ([ (0) x 50 ], [ (0) x 50 ], [ (0) x 50 ], [ (0) x 50 ], [ (0) x 50 ], [ (0) x 50 ]);

# Turn on all pixels in a rectangle A wide and B tall, at the top left
sub rect ($A, $B) {
    for(my $row = 0; $row < $B; $row++) {
	@{$grid[$row]}[0..$A-1] = (1) x $A;
    }
}

# Shift all pixels in column A down by B pixels, with wraparound
sub rotate_col ($A, $B) {
    $B %= @grid;
    my (@save) = map { $grid[$_][$A] } (@grid-$B)..$#grid;
    for(my $i = $#grid-$B; $i >= 0; $i--) {
        $grid[$i+$B][$A] = $grid[$i][$A];
    }
    for(my $i = 0; $i < @save; $i++) {
        $grid[$i][$A] = $save[$i];
    }
}

# Shift all pixels in row A right by B pixels, with wraparound
sub rotate_row ($A, $B) {
    $B %= @{$grid[$A]};
    unshift @{$grid[$A]}, splice(@{$grid[$A]}, -$B);
}

# Process input instructions
while (<>) {
    /^rect (\d+)x(\d+)/               && do { &rect($1, $2);       next; };
    /^rotate column x=(\d+) by (\d+)/ && do { &rotate_col($1, $2); next; };
    /^rotate row y=(\d+) by (\d+)/    && do { &rotate_row($1, $2); next; };
}

say foreach map { join '', map { $_ ? '#' : '.' } @$_ } @grid;
