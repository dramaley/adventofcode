#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings
use Digest::MD5 qw/md5_hex/;

chomp(our $salt = <>);

# Calculate a stretched md5, given the index
sub stretched ($index) {
    my $hash = md5_hex($salt, $index);
    $hash = md5_hex($hash) foreach 1..2016;
    return $hash;
}

my $index = 0;
my @indices;
my @hashes;
while (@indices < 64) {
    my $hash = shift(@hashes) // &stretched($index);
    if ($hash =~ m/(\w)\1\1/) {         # Find a character repeated 3 times
        my $pattern = ($1) x 5;         # ...and save it 5× as the pattern
        # Populate @hashes with the next 1000 hashes
        push @hashes, map { &stretched($index+$_+1) } scalar(@hashes)..999;
        # Save the index if the pattern is in those next 1000 hashes
        push @indices, $index if grep { /${pattern}/ } @hashes;
    }
#    say "${index}: ${hash}";
    $index++;
}
say $indices[63];
