#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings
use utf8;

# What to add to ($row, $col) for each direction
our @movement = ([-1,  0],      # Up
                 [ 0,  1],      # Right
                 [ 1,  0],      # Down
                 [ 0, -1]);     # Left

# Grid is unbounded (can go negative), so read it into a hash with row,col keys
our %grid;
while (<>) {
    while (m/#/g) {
        my $key = ($. - 1) . ',' . (pos() - 1);
        $grid{$key} = ();
    }
}

# Starting position
our $row = ($.-1)/2;
our $col = $row;
our $dir = 0;

my $infection = 0;
foreach (1..10000) {
    my $key = "${row},${col}";
    if (exists $grid{$key}) {   # Check infection status
        $dir++;                 # Turn right
        delete $grid{$key};     # Clean the node
    } else {
        $dir--;                 # Turn left
        $grid{$key} = ();       # Infect the node
        $infection++;           # Track number of infections done
    }
    $dir %= @movement;
    my ($Δrow, $Δcol) = @{$movement[$dir]};   # Move it
    $row += $Δrow;
    $col += $Δcol;
}
say $infection;
