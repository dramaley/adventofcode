#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings

#our @pgms = ('a'..'e'); # Sample
our @pgms = ('a'..'p'); # Real data
our @moves = map { chomp; split /,/; } <>;
our $iterations = 1_000_000_000;

my %seen;
for (my $i = 1; $i <= $iterations; $i++) {
    foreach (@moves) {
        m/^s(\d+)$/        && do { unshift @pgms, splice(@pgms, -$1); next;};
        m/^x(\d+)\/(\d+)$/ && do { @pgms[$1, $2] = @pgms[$2, $1]; next; };
        m/^p(\w)\/(\w)$/   && do { my @indices = (grep { $pgms[$_] eq $1 or
                                                         $pgms[$_] eq $2 }
                                                  0..$#pgms);
                                   @pgms[@indices] = @pgms[reverse @indices];
                                   next; };
        die;
    }

    my $key = join('', @pgms);
    if (exists $seen{$key}) {
        # Loop detected, take a great leap forward
        my $repeat = $i - $seen{$key};
        my $leap = $repeat * int(($iterations - $i) / $repeat);
        $i += $leap;
        %seen = ();
    } else {
        $seen{$key} = $i;
    }
}

say join('', @pgms);
