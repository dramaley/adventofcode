#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings

our ($step) = map { chomp; int; } <>;
our @buffer = (0);
our $position = 0;

foreach my $new (1..2017) {
    # Find new position
    $position += $step;
    $position %= @buffer;
    $position++;
    # Insert new value
    splice(@buffer, $position, 0, $new);
}

say $buffer[($position + 1) % @buffer];
