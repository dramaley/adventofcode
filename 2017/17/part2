#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings

our ($step) = map { chomp; int; } <>;
our $position = 0;

# Instead of maintaining the whole buffer and doing increasingly-expensive
# splice operations, just track what position we'd be inserting into, and only
# track what would have been $buffer[1] (the position after value 0, which is
# always in $buffer[0]).
my $one;
foreach my $new (1..50_000_000) {
    # Find new position
    $position += $step;
    $position %= $new;
    $position++;
    # Save this value
    $one = $new if $position == 1;
}

say $one;
