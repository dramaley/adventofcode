#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings

our $ITERATIONS = 5;
our %mapping = map { chomp; split / => / } <>;


# Display a matrix
sub display ($matrix) {
    say '[', join('', @$_), ']' foreach @$matrix;
    print "\n";
}

# Matrix operations. Works only on 2×2 and 3×3 matrices, in string form.
sub flip ($m) {
    $m =~ s/^(.)(.)(.?)(.)(.)(.)(.?)(.?)(.?)(.?)(.?)$/$9$10$11$8$5$6$7$4$1$2$3/;
    return $m;
}
sub transpose ($m) {
    $m =~ s/^(.)(.)(.?)(.)(.)(.)(.?)(.?)(.?)(.?)(.?)$/$1$5$9$4$2$6$10$8$3$7$11/;
    return $m;
}

# Add an alias to the mapping
sub rekey ($old_key, $new_key) {
    if (not exists $mapping{$new_key}) {
        $mapping{$new_key} = $mapping{$old_key};
    } else {
        # Sanity check to ensure input was fully consistent
        die if $mapping{$new_key} ne $mapping{$old_key};
    }
}

# Flesh out the mapping by adding rotated/flipped key aliases.
# Running transpose + flip 4 times will accomplish that. Demonstration:
#     [1 2 3]      [1 4 7]      [3 6 9]      [3 2 1]      [9 8 7]
#     [4 5 6] -T-> [2 5 8] -F-> [2 5 8] -T-> [6 5 4] -F-> [6 5 4]
#     [7 8 9]      [3 6 9]      [1 4 7]      [9 8 7]      [3 2 1]
#
#                  [9 6 3]      [7 4 1]      [7 8 9]      [1 2 3]
#             -T-> [8 5 2] -F-> [8 5 2] -T-> [4 5 6] -F-> [4 5 6]
#                  [7 4 1]      [9 6 3]      [1 2 3]      [7 8 9]
# (The last flip is unnecessary but leaving it in results in cleaner code.)
foreach my $key (keys %mapping) {
    foreach (1..4) {
        my $new_key = &transpose($key);
        &rekey($key, $new_key);
        $key = $new_key;

        $new_key = &flip($key);
        &rekey($key, $new_key);
        $key = $new_key;
    }
}

# Run the program!
our @grid = (['.', '#', '.'],
             ['.', '.', '#'],
             ['#', '#', '#']);
foreach (1..$ITERATIONS) {
    my $chunk_size = (@grid % 2 == 0 ? 2 : 3);
    my @new_grid;
    for (my $row = 0; $row < @grid/$chunk_size; $row++) {
        my $srow = $row * $chunk_size;          # Source row
        my $drow = $row * ($chunk_size + 1);    # Destination row
        for (my $col = 0; $col < @{$grid[$row]}/$chunk_size; $col++) {
            my $scol = $col * $chunk_size;      # Source col
            # Figure out the mapping keys
            my (@srows) = $srow..($srow+$chunk_size-1);
            my (@scols) = $scol..($scol+$chunk_size-1);
            my $key = join('/', map { join('', @{$grid[$_]}[@scols] ) } @srows);
            # Read the mapping and add it to the new grid
            my (@new) = map { [ split // ] } split('/', $mapping{$key});
            foreach my $r (0..$#new) {
                push @{$new_grid[$drow+$r]}, @{$new[$r]};
            }
        }
    }
    @grid = @new_grid;
}

#&display(\@grid);   # Show the grid
say scalar grep { /#/ } map { @$_ } @grid;
