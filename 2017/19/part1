#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings
use utf8;

# What to add to ($row, $col) for each direction
our @movement = ([-1,  0],      # Up
                 [ 0,  1],      # Right
                 [ 1,  0],      # Down
                 [ 0, -1]);     # Left

# Get the grid and starting position
our @grid = map { chomp; [ split // ] } <>;
our $row = 0;
our $col = (grep { $grid[$row][$_] eq '|' } 0..$#{$grid[$row]})[0];
our $dir = 2;   # Down

# Follow the path
my $letters = '';
while (my $char = $grid[$row][$col]) {
    last if $char eq ' ';                       # Strayed from the path
    $letters .= $char if $char =~ m/[A-Z]/;     # Found a letter
    if ($char eq '+') {                         # Pick a new direction
        $dir = (grep { my ($Δrow, $Δcol) = @{$movement[$_]};
                       ($grid[$row+$Δrow][$col+$Δcol] // '') ne ' '; }
                (($dir-1) % @movement, ($dir+1) % @movement))[0];
    }
    my ($Δrow, $Δcol) = @{$movement[$dir]};   # Move it
    $row += $Δrow;
    $col += $Δcol;
}
say $letters;
