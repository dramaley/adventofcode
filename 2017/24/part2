#!/usr/bin/perl

use v5.36.0;    # Implies strict + warnings

our $components = join(' ', map { chomp; $_ } <>);

# Given a port, length, and components...
sub bridge ($port, $length, $comps) {
    my @strengths = ([ $length, 0 ]);
    while ($comps =~ m/\b(?<m>${port}\/(?<p2>\d+)|(?<p2>\d+)\/${port})\b/g) {
        my ($match, $port2) = @+{'m','p2'};
        (my $new_comps = $comps) =~ s/\b${match}\b//;

        my ($len, $str) = @{ &bridge($port2, $length+1, $new_comps) };
        $str += $port;

        push @strengths, [ $len, $str ];
    }

    my ($len, $str) = @{(sort { $$a[0] <=> $$b[0] or $$a[1] <=> $$b[1] } @strengths)[-1]};
    return [$len, $port + $str];
}

say join ' ', @{ &bridge(0, 0, $components) };
